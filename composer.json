{
	"name": "mediawiki/opensearch-query",
	"type": "mediawiki-extension",
	"description": "MediaWiki extension for querying OpenSearch indices (view-equivalent queries, query_string full-text search) and single-document fetches from within wiki pages.",
	"keywords": [
		"mediawiki",
		"opensearch",
		"search",
		"extension",
		"parserhook"
	],
	"homepage": "https://github.com/toniher/OpenSearch_Query",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Toniher",
			"homepage": "https://www.mediawiki.org/wiki/User:Toniher",
			"role": "Developer"
		}
	],
	"support": {
		"issues": "https://github.com/toniher/OpenSearch_Query/issues",
		"source": "https://github.com/toniher/OpenSearch_Query"
	},
	"require": {
		"php": ">=7.4",
		"composer/installers": ">=1.0.1"
	},
	"extra": {
		"installer-name": "OpenSearch_Query"
	}
}
