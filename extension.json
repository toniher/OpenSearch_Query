{
	"name": "OpenSearch_Query",
	"version": "1.1.0",
	"author": [ "Toniher" ],
	"url": "https://www.mediawiki.org/wiki/User:Toniher",
	"descriptionmsg": "OpenSearch_Query-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "parserhook",
	"requires": {
		"MediaWiki": ">= 1.35.0"
	},
	"AutoloadClasses": {
		"OpenSearch_Query": "includes/OpenSearch_Query.php",
		"OpenSearch_QueryHooks": "includes/OpenSearch_QueryHooks.php",
		"OpenSearch_Connection": "includes/OpenSearch_Connection.php",
		"OpenSearch_QueryBuilder": "includes/OpenSearch_QueryBuilder.php",
		"OpenSearch_Index": "includes/OpenSearch_Index.php",
		"OpenSearch_Search": "includes/OpenSearch_Search.php",
		"OpenSearch_Document": "includes/OpenSearch_Document.php",
		"ApiOpenSearch_Query": "includes/Api/ApiOpenSearch_Query.php",
		"ApiOpenSearch_Search": "includes/Api/ApiOpenSearch_Search.php",
		"ApiOpenSearch_Document": "includes/Api/ApiOpenSearch_Document.php",
		"ApiCouchDB_Query": "includes/Api/ApiCouchDB_Query.php",
		"ApiCouchDB_Query_Lucene": "includes/Api/ApiCouchDB_Query_Lucene.php",
		"ApiCouchDB_Query_Nouveau": "includes/Api/ApiCouchDB_Query_Nouveau.php",
		"ApiCouchDB_Document": "includes/Api/ApiCouchDB_Document.php"
	},
	"MessagesDirs": {
		"OpenSearch_Query": [ "i18n" ]
	},
	"ExtensionMessagesFiles": {
		"OpenSearch_QueryMagic": "OpenSearch_Query.i18n.magic.php"
	},
	"Hooks": {
		"ParserFirstCallInit": "OpenSearch_QueryHooks::onParserFirstCallInit"
	},
	"APIModules": {
		"opensearch-query": "ApiOpenSearch_Query",
		"opensearch-search": "ApiOpenSearch_Search",
		"opensearch-document": "ApiOpenSearch_Document",
		"couchdb-query": "ApiCouchDB_Query",
		"couchdb-lucene-query": "ApiCouchDB_Query_Lucene",
		"couchdb-nouveau-query": "ApiCouchDB_Query_Nouveau",
		"couchdb-document": "ApiCouchDB_Document"
	},
	"ResourceModules": {
		"ext.OpenSearch_Query": {
			"scripts": [ "libs/main.js" ],
			"styles": [ "styles/main.less" ],
			"dependencies": [ "jquery.tablesorter" ]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteExtPath": "OpenSearch_Query"
	},
	"config": {
		"OpenSearch_Query": {
			"value": {
				"params": {
					"db": {
						"host": "host",
						"port": 9200,
						"protocol": "https",
						"username": "",
						"password": "",
						"timeout": 10,
						"connectTimeout": 5
					}
				},
				"queries": {
					"db": {
						"text": {
							"index": "mydb-docs",
							"textfields": [ "title^3", "body" ],
							"source": [ "title", "body", "pagename" ]
						},
						"coords": {
							"index": "mydb-coords",
							"keyfield": "chrom.keyword"
						}
					}
				},
				"document": {
					"db": {
						"host": "host",
						"port": 9200,
						"protocol": "https",
						"index": "mydb-docs"
					}
				},
				"map": {
					"db": {
						"text": {
							"pagename": "title"
						}
					}
				}
			}
		}
	},
	"manifest_version": 2
}
